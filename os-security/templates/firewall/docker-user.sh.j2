#!/bin/bash
# os-security · DOCKER-USER rules · scenario {{ scenario }} · generated by render.py (do not edit)
# The chain docker leaves for us, evaluated BEFORE docker's own forwarding rules:
# a container may reach the host's OWN addresses only on the allowed ports, and
# never the docker/libvirt/ssh/swarm management ports. Idempotent: flushes only
# the rules it owns (comment tag) and re-adds them.
set -eu
TAG="os-security:{{ scenario }}"
IPT=${IPT:-iptables}
$IPT -N DOCKER-USER 2>/dev/null || true
# remove ours, keep anyone else's
while $IPT -S DOCKER-USER | grep -q -- "--comment $TAG"; do
    RULE=$($IPT -S DOCKER-USER | grep -- "--comment $TAG" | head -1 | sed 's/^-A /-D /')
    # shellcheck disable=SC2086
    $IPT $RULE
done
# host addresses (all of them: containers can hit any local IP, incl. the docker bridge gateways)
HOST_ADDRS=$(ip -4 -o addr show | awk '{print $4}' | cut -d/ -f1 | sort -u)
{% for net in docker.networks %}
NETS="{{ docker.networks | join(' ') }}"
{% endfor %}
# 1. established flows back to containers
$IPT -I DOCKER-USER 1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT -m comment --comment "$TAG"
n=2
for H in $HOST_ADDRS; do
{% for a in allow_to_host %}
    $IPT -I DOCKER-USER $n -d "$H" -p {{ a.proto }} --dport {{ a.port }} -j ACCEPT -m comment --comment "$TAG"; n=$((n+1))   # {{ a.why }}
{% endfor %}
{% for p in deny_to_host_ports %}
    $IPT -I DOCKER-USER $n -d "$H" -p tcp --dport {{ p }} -j DROP -m comment --comment "$TAG"; n=$((n+1))
{% endfor %}
    # everything else on the host: dropped (containers reach the world through the router/proxy, never the host's services)
    $IPT -I DOCKER-USER $n -d "$H" -j DROP -m comment --comment "$TAG"; n=$((n+1))
done
# docker's socket over TCP must never be reachable from a container even if someone enables it
$IPT -I DOCKER-USER $n -p tcp -m multiport --dports 2375,2376 -j DROP -m comment --comment "$TAG"; n=$((n+1))
$IPT -A DOCKER-USER -j RETURN -m comment --comment "$TAG" 2>/dev/null || true
echo "DOCKER-USER: $(($n-1)) rule(s) for {{ scenario }} ($(echo "$HOST_ADDRS" | wc -w) host address(es))"
