#!/bin/bash
# os-security · host firewall (ufw) · scenario {{ scenario }} · generated by render.py (do not edit)
# Default deny incoming; only the scenario's ports, each from a named source set.
# Sources: any | isle (the isle VLAN subnet) | isle-lan (isle + the owner's LAN) |
# admin-lan (the operator's network) | swarm (the swarm peers). Resolved from the
# environment at apply time (OS_SEC_ISLE_NET, OS_SEC_LAN_NET, OS_SEC_ADMIN_NET,
# OS_SEC_SWARM_PEERS) — an unresolved source is SKIPPED with a warning, never widened to any.
# Note: docker's published ports bypass ufw (docker inserts its own rules ahead of it);
# DOCKER-USER (docker-user.sh) is the rule set that governs container traffic.
set -eu
{% if not ufw.enabled %}
echo "ufw: scenario {{ scenario }} leaves the host firewall alone"
exit 0
{% endif %}
command -v ufw >/dev/null || { echo "ufw not installed (apt install ufw)" >&2; exit 1; }
ISLE_NET="${OS_SEC_ISLE_NET:-}"; LAN_NET="${OS_SEC_LAN_NET:-}"; ADMIN_NET="${OS_SEC_ADMIN_NET:-}"; SWARM_PEERS="${OS_SEC_SWARM_PEERS:-}"
src_list() { case "$1" in
    any) echo "any" ;;
    isle) echo "$ISLE_NET" ;;
    isle-lan) echo "$ISLE_NET $LAN_NET" ;;
    admin-lan) echo "$ADMIN_NET" ;;
    swarm) echo "$SWARM_PEERS" ;;
esac; }
ufw --force reset >/dev/null
ufw default {{ ufw.default_incoming }} incoming >/dev/null
ufw default allow outgoing >/dev/null
{% for r in ufw.allow %}
for S in $(src_list "{{ r.from }}"); do
    [ -n "$S" ] || { echo "  skip {{ r.port }}/{{ r.proto }} from {{ r.from }}: source unresolved (set OS_SEC_* env)"; continue; }
    if [ "$S" = any ]; then ufw allow {{ r.port }}{% if r.proto != 'any' %}/{{ r.proto }}{% endif %} comment "os-security:{{ r.why }}" >/dev/null
    else ufw allow from "$S" to any port {{ r.port }}{% if r.proto != 'any' %} proto {{ r.proto }}{% endif %} comment "os-security:{{ r.why }}" >/dev/null; fi
done
{% endfor %}
ufw --force enable >/dev/null
ufw status numbered | head -40
