{
  "_comment": "os-security · docker daemon settings · scenario {{ scenario }} · RENDERED AND DIFFED ONLY: apply.sh never restarts docker; merge into /etc/docker/daemon.json in a window (userns-remap moves image/volume ownership — see plan D1)",
{% if docker.userns_remap %}
  "userns-remap": "{{ docker.userns_remap }}",
{% endif %}
  "no-new-privileges": {{ 'true' if docker.no_new_privileges else 'false' }},
  "icc": {{ 'true' if docker.icc else 'false' }},
  "live-restore": true,
  "log-driver": "json-file",
  "log-opts": { "max-size": "20m", "max-file": "5" },
  "default-ulimits": { "nofile": { "Name": "nofile", "Hard": 65536, "Soft": 65536 }, "nproc": { "Name": "nproc", "Hard": 4096, "Soft": 4096 } }
}
