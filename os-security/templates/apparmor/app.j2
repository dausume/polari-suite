{#- os-security: ONE AppArmor profile template. Every app (and every fixed piece,
    and on the swarm route the node-wide docker-default) is an instance: name,
    profile kind, writable paths, network, capabilities, devices, ports come
    from the manifest `security` stanza (or the scenario's `fixed` list).
    Rendered by render.py; loaded by apply.sh (complain or enforce).

    Shape (his rule 2026-09-12, warn-only by default), learned the hard way:
      * AppArmor enforces EXPLICIT `deny` rules even in complain mode, quietly
        (apparmor.d(5): "complain mode will only convert implicit denials to
        ALLOWED"; proven on an isle 2026-09-12 with a probe profile). So a
        "warn-only" profile must not carry denies of its own, and a blanket
        `file,` allow would log nothing. Therefore:
      * the profile is an ALLOW-LIST (the image readable+executable, the declared
        paths writable, the declared network and capabilities). In complain mode
        everything outside it is permitted and logged as apparmor="ALLOWED" —
        `pol security os allowed` turns those lines into the list of what
        enforcing would break.
      * docker's own stock explicit denies (every container is under them today,
        via docker-default) are kept in BOTH modes: complain never denies more
        than stock docker does, so loading it cannot break what runs today.
      * Polari's stricter explicit denies are added in ENFORCE mode only, where
        they win over any broad allow above them.
    Kinds: web-app | worker | gateway | vpn-gateway | hardware-extension | node -#}
#include <tunables/global>

# {{ profile_name }} — generated by os-security/render.py for scenario {{ scenario }} ({{ mode }})
# app {{ app.name }} · kind {{ app.profile }} · image {{ app.image }}
# writable: {{ app.writable | join(', ') if app.writable else '(none)' }} · network: {{ app.network | join(',') }} · caps: {{ app.capabilities | join(',') if app.capabilities else '(none)' }}
{% if mode == 'complain' %}
# WARN-ONLY: an allow-list in complain mode — anything outside it is permitted and logged as
# apparmor="ALLOWED" (harvest: pol security os allowed). The only explicit denies here are docker's
# stock ones (explicit denies are enforced even in complain mode), so this never denies more than
# the docker-default profile every container runs under today.
{% else %}
# ENFORCE: the same allow-list plus explicit deny rules (docker's stock set and Polari's own), which
# win over any allow — an escape attempt is denied even where a broad rule above would permit it.
{% endif %}
profile {{ profile_name }} flags=(attach_disconnected,mediate_deleted{% if mode == 'complain' %},complain{% endif %}) {
  #include <abstractions/base>

  # ---- the runtime must be able to signal us (docker stop/kill, exec, health checks) — stock docker
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=dockerd,
  signal (send,receive) peer={{ profile_name }},
  ptrace (trace,read,tracedby,readby) peer={{ profile_name }},

  # ---- network: only what the app declared --------------------------------
{% if 'none' not in app.network %}
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network unix seqpacket,
  network netlink dgram,
{% if app.profile in ('gateway', 'vpn-gateway') %}
  network inet raw,
  network inet6 raw,
  network netlink raw,
  network packet raw,
{% endif %}
{% endif %}

  # ---- capabilities: only the declared ones (the runtime drops the rest) ----
{% for cap in app.capabilities %}
  capability {{ cap | lower }},
{% endfor %}

  # ---- the filesystem: the image readable and executable, the declared paths writable ---
  /** rmix,
  umount,
{% for path in app.writable %}
  {{ path }} rw,
  {{ path }}/** rwk,
{% endfor %}
  /tmp/ rw,
  /tmp/** rwk,
  /run/ rw,
  /run/** rwk,
  /dev/shm/ rw,
  /dev/shm/** rwk,
  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/urandom r,
  /dev/random r,
  /dev/tty rw,
  /dev/console rw,
  /dev/pts/ r,
  /dev/pts/** rw,
  /dev/ptmx rw,
{% if app.profile == 'hardware-extension' %}
  # hardware extension: only the devices hwmap assigned (never /dev as a whole)
{% for dev in app.devices %}
  {{ dev }} rw,
{% endfor %}
{% endif %}

  # ---- docker's stock explicit denies (every container is under these today; kept in both modes)
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
{% if mode == 'enforce' %}

  # ---- Polari's explicit denies (ENFORCE only — they win over every allow above)
  deny remount,
  deny pivot_root,
  deny capability sys_admin,
  deny capability sys_module,
  deny capability sys_rawio,
  deny capability sys_ptrace,
  deny capability sys_boot,
  deny capability mac_admin,
  deny capability mac_override,
{% if 'DAC_READ_SEARCH' not in app.capabilities %}
  deny capability dac_override,
  deny capability dac_read_search,
{% endif %}
  deny @{PROC}/mem rwklx,
  deny @{PROC}/kmem rwklx,
  # a rooted app must not write over its own image, config or entrypoints
  deny /etc/** w,
  deny /usr/** w,
  deny /bin/** w,
  deny /sbin/** w,
  deny /lib/** w,
  deny /lib64/** w,
  deny /boot/** rwklx,
  deny /root/** rwklx,
  deny /home/** rwklx,
  deny /var/run/docker.sock rwklx,
  deny /run/docker.sock rwklx,
  deny /var/run/libvirt/** rwklx,
{% if app.profile != 'hardware-extension' %}
  deny /dev/{tty,vc,hidraw,ttyUSB,ttyACM,video,snd,bus}* rwklx,
  deny /dev/{mem,kmem,port,sd,nvme,mapper}* rwklx,
{% endif %}
{% if 'none' in app.network %}
  deny network,
{% elif app.profile not in ('gateway', 'vpn-gateway') %}
  deny network raw,
  deny network packet,
{% endif %}
{% endif %}
}
