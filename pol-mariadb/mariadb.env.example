# MariaDB Credentials — EXAMPLE (real file is gitignored + AUTOGENERATED)
# Generate with: ./setup-polari-security.sh dev --env-only   (random, no prompts)
# Knobs: POLARI_MYSQL_ROOT_PASS, POLARI_KC_DB_PASS, POLARI_PSC_DB_PASS.
# Passwords are baked into the DB volume at first init — the generator never
# overwrites an existing file.
MARIADB_ROOT_PASSWORD=REPLACE_ME_RUN_setup-polari-security.sh
KC_DB_NAME=keycloak
KC_DB_USER=kc
KC_DB_PASSWORD=REPLACE_ME_RUN_setup-polari-security.sh
PSC_DB_NAME=psc
PSC_SCORING_DB_NAME=psc_scoring_db
PSC_LOCATION_DB_NAME=psc_location_db
PSC_DB_USER=psc-scorecard-server
PSC_DB_PASSWORD=REPLACE_ME_RUN_setup-polari-security.sh
