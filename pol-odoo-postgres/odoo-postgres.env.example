# Odoo PostgreSQL credentials (odoo-postgres service)
# REAL file (odoo-postgres.env) is generated by setup-polari-security.sh
# and gitignored (*.env). Keep in sync with pol-odoo/odoo.env.
# Knob: POLARI_ODOO_DB_PASS (set before running the setup to pin the value).
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me
# Keep the default 'postgres' maintenance DB; odoo_sim / odoo_ops are
# created via `pol odoo init-db <sim|ops>`.
POSTGRES_DB=postgres
