# ==============================================================================
# POLARI SUITE ROOT .gitignore
# ==============================================================================
# This file applies to the polari-suite root directory.
# Subprojects (political-scorecard-node, polari-rf-node) have their own .gitignore files.

# ==============================================================================
# SSL/TLS CERTIFICATES AND KEYS
# ==============================================================================
# SECURITY: Never commit certificates or private keys to version control
# This catches certs in any subdirectory that might not have its own .gitignore
*.crt
*.key
*.pem
*.p12
*.pfx
*.cer
*.der

# Certificate directories
**/certs/
**/ssl/
**/certificates/

# Specific cert locations for Polari core services
pol-proxy/certs/
pol-keycloak/certs/

# ==============================================================================
# ENVIRONMENT FILES
# ==============================================================================
# Environment files often contain sensitive data (API keys, passwords, etc.)
.env
.env.local
.env.*.local
*.env

# ==============================================================================
# IDE AND EDITOR FILES
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ==============================================================================
# OS FILES
# ==============================================================================
Thumbs.db
.DS_Store

# ==============================================================================
# LOGS
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# DOCKER
# ==============================================================================
# Override files are local development configs
docker-compose.override.yml

# ==============================================================================
# TEMPORARY FILES
# ==============================================================================
.cache/
.tmp/
temp/

# ==============================================================================
# GENERATED FILES (staging-setup.sh, prod-setup.sh output)
# ==============================================================================
# These contain environment-specific sensitive configuration.
# Templates (*.template) are committed; generated files are not.
.generated/

# Specific generated configs that might be placed elsewhere
nginx.staging.conf
nginx.prod.conf
.env.staging
.env.prod

# Claude Code local files (settings, memory) — keep private
.claude/
CLAUDE.local.md

# Generated mirror trees (pol build render --project suite)
jinja-build/
jinja-templates/

# ==============================================================================
# LOCAL / PRIVATE RUNTIME STATE — keep private
# ==============================================================================
# MCP adapter local config, tokens, logs, and any local memory/scratch dumps.
# (.env, .claude/, and *.log are already ignored above; these are extra guards
#  so private/local information never gets tracked.)
polari-mcp/.env
polari-mcp/*.local.json
polari-mcp/logs/
**/*.secrets.json
**/*.memory.local
**/memory.local/
mcp-local-*.json

# Python bytecode
__pycache__/
*.pyc

# WireGuard remote-access artifacts (private keys) — keep private
.remote-wg/
**/.remote-wg/

# AI-Notes/local — notes that quote third parties (user requests, private
# messages). Never tracked; the functionality gets built, the message stays home.
AI-Notes/local/

# offline build cache (inspectable on disk + in Polari; never committed)
offline-build/
.polari/
