# polari-jenkins/deploy/targets.env.example — DEPLOYMENT TARGETS (dep-0, plan §11).
#
# Copy to deploy/targets.env (gitignored) or write it with:  pol jenkins deploy add <name>
# Read it back:                                              pol jenkins deploy list
# Prove a target is reachable and its conditions:            pol jenkins deploy check <name>
#
# ⚠ NEVER an address or a hostname here: `SSH_ALIAS` is a Host entry in the
#    PIPELINE USER's ssh config (jenkins_home/.ssh/config), authorised with
#    `pol jenkins deploy authorize <name>` — the same shape as the isle target.
#    The NAME is chosen (it is rendered on a page), never the machine's hostname.
#
# Every target is one block. The name's '-' becomes '_' in the keys.
DEPLOY_TARGETS="public-site"

# ---- public-site: the production server
DEPLOY_public_site_SSH_ALIAS=droplet        # ssh alias the pipeline user reaches it by
DEPLOY_public_site_ROUTE=swarm              # swarm = `pol prod apply` on the target (isle = the deb route, later)
DEPLOY_public_site_PROFILE=lean             # the `pol prod` stack size on that box: lean | full
DEPLOY_public_site_CHANNEL=release          # release = only a published release with a passed verdict | test = the tip of test (a staging box)
DEPLOY_public_site_WINDOW=any               # a 5-field cron window (e.g. "0-30 3 * * *" = 03:00–03:30 daily) or any
DEPLOY_public_site_HEALTH="https://example.invalid/ https://api.prf.example.invalid/api/health"
                                            # the routes that must answer 2xx BEFORE and AFTER (space-separated URLs; empty = no health gate)
DEPLOY_public_site_MIN_FREE_GB=4            # disk floor on the target before an apply
DEPLOY_public_site_NEEDS=github-release,ghcr   # the publish routes this target CONSUMES: they must have published for real
DEPLOY_public_site_SETTLE_S=60              # seconds between the apply and the health-after reading
DEPLOY_public_site_HOLD=true                # true = NEVER auto-apply; only `pol jenkins deploy public-site --now` (a person) applies
