# polari-jenkins/device.env.example — THE PIPELINE DEVICE.
#
# Copy to device.env (gitignored) or write it with:  pol jenkins target local
#                                                    pol jenkins target ssh <alias>
# Read it back with:                                 pol jenkins config
# Check it with:                                     pol jenkins doctor
#
# ci-7 (his ask 2026-09-19): the throwaway isle the pipeline builds and
# destroys (ci-3) does NOT have to live on the machine running Jenkins.
# This file says WHERE it goes and how big it may be — and every number
# here is a floor the preflight checks BEFORE a pipeline touches anything.
#
# ⚠ Never write a LAN address or a hostname here that git could see:
#    device.env is gitignored, this .example is not. Use an SSH ALIAS
#    (a Host entry in ~/.ssh/config), never an address.

# ------------------------------------------------------------------ mode
# ci-8 (his addendum 2026-09-19): "some people will also be using this
# pipeline as a way to maintain their own Polari Apps and will only be
# testing the one app they are developing."
#
# suite = the whole Polari suite is built, tested in a throwaway isle and
#         released. The core is built HERE. (today's shape, the default)
# app   = this device maintains ONE Polari app. Name it and its repo below.
#         The core is NOT rebuilt: its debs and images are PULLED from the
#         Polari release named in CI_CORE_SOURCE, and the app is tested
#         against THAT core. Only that app's deb is released, and only to
#         YOUR routes — a fork is never republished under an upstream name.
CI_MODE=suite

# app mode only: the module package you maintain (modules/<name>/polari-app.json)
# and its own repository (the `pol project` standalone loop builds from it).
CI_APP_NAME=
CI_APP_REPO=

# Where the CORE comes from.
#   release:latest   pull the newest official Polari release's core artifacts (the default)
#   release:<tag>    pull that exact release (e.g. release:polari-v2026.09.19)
#   build            rebuild the core from this suite checkout — for a
#                    developer who also patches core
# In app mode the release you name here is what your app is TESTED against,
# and the release record says so (tested_against). "It passed" without a
# named core is a claim nobody can check.
CI_CORE_SOURCE=release:latest

# --------------------------------------------------------- the Polari core
# ci-8: WHERE THE SETTINGS LIVE. Polari is the source of truth for
# everything in this file; this URL is the instance that holds it.
#   pol jenkins sync pull   GET <CI_CORE_URL>/api/cicd and rewrite this file
#   pol jenkins sync push   report readiness, secret PRESENCE and routes back
# Empty = no sync, and this file is the only truth there is — which is also
# what happens when the core does not answer: the file is kept and the
# pipeline says so rather than stalling.
# The posting credential is the secret polari/cicd_ingest_token (an
# administrator mints it: POST /api/cicd/device/token). It may post the five
# mirror kinds and nothing else.
CI_CORE_URL=

# The NAME this device has in Polari (the PipelineDevice row). Choose one —
# it is rendered on a page and served by an API, so it must never be the
# machine's hostname.
CI_DEVICE_NAME=pipeline

# ---------------------------------------------------------------- target
# local = the throwaway isle VM is created on the machine running Jenkins.
#         That machine then needs /dev/kvm, libvirt, and enough free RAM
#         for the controller (2 GB) + a frontend build (~3 GB) + the VM.
# ssh   = the VM is created on another device over ssh. The pipeline
#         device only needs docker; the TARGET needs /dev/kvm + libvirt
#         + passwordless `sudo -n` for the ssh user.
CI_ISLE_TARGET=local

# The ssh ALIAS from ~/.ssh/config (never an address, never a hostname).
# Required when CI_ISLE_TARGET=ssh; ignored when local.
CI_ISLE_SSH_HOST=
# Optional: the remote user, when the alias does not already carry one.
CI_ISLE_SSH_USER=

# ------------------------------------------------------- the throwaway VM
CI_ISLE_VM_NAME=polari-ci-isle
CI_ISLE_VM_RAM_GB=4
CI_ISLE_VM_VCPUS=2
CI_ISLE_VM_DISK_GB=30

# The isle's own router guest runs INSIDE the throwaway VM, so that VM
# needs nested KVM. auto = require it when the target is local (where we
# can read the module parameter), warn otherwise; required = FAIL without
# it; off = do not check (a run without a router guest).
CI_ISLE_NESTED=auto

# Where the throwaway VM's disks, cloud-init seeds and the per-run ssh key
# live ON THE TARGET. Empty = the polari-jenkins pool for a local target,
# /var/tmp/polari-ci-pool for an ssh target.
CI_ISLE_POOL=

# The cloud image the throwaway isle starts from (cached under <pool>/images).
CI_ISLE_IMAGE_URL=https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img

# ----------------------------------------------------------------- floors
# Free disk the pipeline refuses to go below, on the pool AND on the
# target's libvirt image directory (retention.sh guard uses the same number).
CI_MIN_FREE_GB=20
# Free RAM kept spare beyond what the VM asks for.
CI_MIN_RAM_HEADROOM_GB=1

# ------------------------------------------------------------- controller
# ONE build at a time on a home box (the casc numExecutors follows this).
CI_EXECUTORS=1

# -------------------------------------------------- isle testing stages
# WHAT gets tested in a throwaway isle — and therefore WHAT may be
# released at all. Stages are separated by ';', apps within a stage by
# ','. The literal `core` means the core debs only (the isle bundle +
# polari-complete online/offline — the server and frontend, no optional
# app modules).
#
#   core                              only the core, nothing else (default)
#   core; household; electronics      three stages, run one after another
#   core; gears,motors                two stages, the second tests two apps
#
# Each stage gets its OWN throwaway isle: up → install the core debs →
# install that stage's app debs → `pol modules selftest <app>` for each →
# record → down. They run sequentially, so a space-limited device never
# needs room for more than ONE stage at a time: that is the whole point of
# staging instead of one big isle.
#
# ⚠ THE RELEASE RULE: the pipeline only generates artifacts for things it
#   tested. An app whose stage did not pass is left OUT of the release,
#   and with no isle-test results for a version NOTHING is published.
#   So this list is also the list of what can ever ship.
#
# Every name must be a module directory with a polari-app.json:
#   ls polari-rf-node/polari-framework/modules/*/polari-app.json
CI_ISLE_STAGES=core

# Routes that MAY publish for real when their secret is present.
# A route not named here stays DRY even with its secret in place.
# ACTIVE routes: github-release,ghcr,homebrew,apt-repo  (routes/later/* are PARKED)
CI_ROUTES=github-release,ghcr,homebrew,apt-repo

# WHERE this device's releases go. Empty in suite mode (the suite's own routes
# decide). In app mode this is YOUR owner/namespace — the GitHub user or org the
# app deb, the release and the images are published under. A route aimed at the
# upstream Polari owner is a validation FAIL: a fork is never republished under
# an upstream name.
CI_ROUTE_TARGET=

# ---------------------------------------------------- the offline-first cache
# ci-9 (his ask 2026-09-19): "the jenkins pipeline should try and use offline
# artifacts for building where possible, that way we are taking less time when
# repeatedly using the same data."
#
# TIER ONE — one directory under the pool, no services: python wheels, npm
# tarballs, distro debs, saved base images, the throwaway isle's cloud image,
# fetched Polari releases, and the BuildKit layer cache. Every builder reads it
# first and folds what it fetched back in.
#
# THE RULE: the cache is an OPTIMISATION, never a precondition — an empty cache
# still builds, over the network, and says so.
#
#   pol jenkins cache status                what is in it, and the last run's hit rate
#   pol jenkins cache prune --older-than 30 the ONE deleter (retention.sh never touches it)
CI_CACHE=on

# Where it lives. Empty = <pool>/cache. Relative to the POOL on purpose: an ssh
# isle target then caches its cloud image on its OWN disk rather than over scp.
CI_CACHE_DIR=

# The budget. The doctor WARNs past it; nothing here ever deletes on its own —
# `pol jenkins cache prune` does, and only entries nothing has used for a while.
CI_CACHE_MAX_GB=40

# TIER TWO — optional caching PROXIES beside the controller
# (docker-compose.proxies.yml: registry:2 pull-through, devpi for pip, verdaccio
# for npm, apt-cacher-ng for apt). All bound to 127.0.0.1, outbound-only, volumes
# under the cache dir. OFF by default; a pipeline never starts them, it only uses
# them when they already answer and falls back silently when they do not.
#   pol jenkins cache proxies up|down|status
CI_CACHE_PROXIES=off
