# copy to .env (gitignored). Everything binds to 127.0.0.1 — the host tier is never exposed.
POLARI_SUITE=/home/user/Desktop/polari-suite     # the checkout the jobs build FROM (mounted read-only as the seed; jobs clone GitHub)
JENKINS_HOME=./jenkins_home                       # controller state (gitignored)
JENKINS_PORT=8080
UID=1000
GID=1000
DOCKER_GID=999                                    # getent group docker | cut -d: -f3

# ---- written by `sudo pol jenkins init-device` (ci-7 (C)) --------------------
# The controller runs as the polari-ci SYSTEM user and mounts the system
# secrets directory, so the secrets are reachable by root (sudo) and by the
# pipeline process only. Absent = the fallback posture, which the doctor warns
# about: secrets readable by every process of the host user.
JENKINS_UID=
JENKINS_GID=
# left EMPTY on purpose: empty = ./secrets (the fallback the doctor warns about).
# init-device sets it to /etc/polari-jenkins/secrets once that directory exists.
POLARI_SECRETS_DIR=

# WHEN a change to main RUNS (the release, its publish, the deploy step): the quiet hour on the site.
#   midnight (default) · HH:MM daily (e.g. 03:30) · <weekday> HH:MM weekly (e.g. sun 02:00) · now
# The clock is this device's time zone (pol jenkins up exports it; TZ= here overrides).
CI_MAIN_RELEASE_AT=midnight
