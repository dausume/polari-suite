// polari-test — THE TEST PIPELINE (ci-12, his ruling 2026-09-19, verbatim):
//
//   "We need to create a new test branch. After pushing to the test branch we
//    kick off the testing pipeline for polari and it does the builds and scans
//    and runs in test mode which automates running tests for all of the modules
//    and apps configured to run in that particular pipeline run. dev is a place
//    for staging development work that we are rapidly iterating through. Pushing
//    our dev work to test will kick off the process of wiping what we have
//    locally and then running all of our tests and scans. Based on the outcome
//    on the test stage, we make a decision to push changes to main."
//
// So: WIPE → BUILD → SCAN → TEST → ONE VERDICT. Nothing is published here, ever.
// The verdict is the product of this job, and `polari-release` (and
// `pol jenkins promote main`) read it — they never re-run the tests.
//
// THE JOB'S COLOUR MEANS "DID IT RUN", NOT "DID IT PASS". SUCCESS when the run
// reached the end and recorded a verdict; FAILURE only when a stage could not
// run. A failed test is a RECORDED VERDICT — turning it into a red build would
// make the verdict redundant and tempt somebody to read the colour instead of
// the reasons.
//
// SCANS ARE ADVISORY (his standing rule). Every scan stage exits 0, the counts
// ride in the verdict, and no finding changes the verdict by one letter.
//
// THE QUEUE (his addendum, same day): one item deep, latest wins, five quiet
// minutes across the whole forest before anything starts. quiet.sh owns all of
// that; this file asks it and obeys. A deferral is NOT_BUILT — the pending item
// stays pending and the next poll takes it, so no backlog can form.
//
// TWO CHECKS, AND WHY. A shallow checkout of this forest takes ~6 minutes on the
// pipeline device, so deferring after one is an expensive way to do nothing. The
// run therefore asks TWICE:
//   · `quiet.sh gate` — ONE `git ls-remote` of the superproject, before any
//     checkout. "Is there anything here that is not already tested, and has it
//     stopped moving?" An idle tick costs a second.
//   · `quiet.sh check` — the FULL forest, after the checkout, because the only
//     place the submodule REMOTES are written down is the checkout's own
//     .gitmodules. A submodule that moved while the superproject stood still is
//     caught here.
//
// AND WHY THE TRIGGER IS PERIODIC, NOT SCM. Jenkins' SCM trigger fires on a
// CHANGE. A run that defers because the change is still landing would then never
// be retried — by the time the forest IS quiet, nothing has changed again. That
// is not a hypothetical: it is what build #1 did on the pipeline device. So the
// job ticks on a timer and `gate` makes an idle tick cheap.
//
// AND WHY `PROCEED` IS A GUARD ON EVERY STAGE. Declarative has no "stop here
// without failing": `error()` makes the build FAILURE, which is exactly the
// wrong colour for "there was nothing to do". So stage 0 decides once, every
// later stage carries `when { expression { env.PROCEED == 'yes' } }`, and `post`
// stamps NOT_BUILT. Verbose, and it is the honest shape.
pipeline {
  agent any
  // abortPrevious:false — aborting the running build on every new poll would
  // mean a busy branch never finishes a test at all. The single pending item in
  // quiet.sh is what stops a backlog; this option only stops overlap.
  // The `polari-build` lock is shared with polari-release: the two never run at
  // the same time, which is his "we should not run both at the same time".
  options {
    timestamps()
    timeout(time: 240, unit: 'MINUTES')
    disableConcurrentBuilds(abortPrevious: false)
    lock(resource: 'polari-build')
  }
  environment {
    POOL = "${env.POLARI_POOL ?: '/var/polari-pool'}"
    ISLE = "${env.POLARI_ISLE ?: '/var/polari-jenkins/isle'}"
    // no readJSON anywhere in this file: pipeline-utility-steps is not installed
    JSONGET = '/var/polari-jenkins/jsonget.py'
  }
  stages {

    // ---------------------------------------------------------- 0. is there work?
    // The cheap half: whose turn it is, and one ls-remote of the superproject.
    // No checkout, so an idle tick costs a second rather than a six-minute clone.
    stage('is there anything to test, and is it my turn?') {
      steps {
        script {
          env.PROCEED = 'no'
          def turn = sh(returnStatus: true, script: 'bash /var/polari-jenkins/quiet.sh turn test --once')
          if (turn == 7) {
            env.DEFER_WHY = 'yielding to polari-release — it has something pending and test ran last. ' +
                            'The pending test item is untouched; the next tick takes it.'
            echo env.DEFER_WHY
            return
          }
          // rule 4: a build a PERSON started (Build Now) is the manual run a failed pipeline waits for.
          if (currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')) {
            sh "bash /var/polari-jenkins/quiet.sh rearm test 'started by hand in Jenkins' || true"
          }
          // NO REGEX MATCHER IN A LOCAL. A java.util.regex.Matcher is not
          // serializable, and CPS persists every local across a step boundary —
          // `def m = (out =~ /…/)` killed build #4 on the pipeline device with
          // NotSerializableException AFTER every check had passed. The exit code
          // is what we actually want, so take it directly and read the sha back
          // out of the log with sed.
          def rc = sh(returnStatus: true,
                      script: 'set +e; bash /var/polari-jenkins/quiet.sh gate test > .quiet-gate.log 2>&1; rc=$?; cat .quiet-gate.log; exit $rc')
          if (rc == 6) {
            env.DEFER_WHY = 'nothing to test yet (already covered, or the branch is still moving) — the next tick looks again'
            echo env.DEFER_WHY
            return
          }
          if (rc != 0) { error("quiet.sh could not read the superproject remote (rc=${rc})") }
          env.PROCEED = 'gate'          // worth a checkout; the full check confirms it
        }
      }
    }

    // ------------------------------------------------- 1. the TIP, not the trigger
    // The single pending item never named a sha — it meant "the newest state of
    // test". So the checkout is of the branch TIP. Anything else would build a
    // superseded commit and call its verdict current.
    stage('checkout the TIP of test') {
      when { expression { env.PROCEED == 'gate' } }
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/test']],
                  userRemoteConfigs: [[url: 'https://github.com/dausume/polari-suite.git']],
                  extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: false,
                                parentCredentials: false, trackingSubmodules: false, shallow: true]]])
        sh '''set -eu
          git -C polari-rf-node submodule update --init --depth 1 polari-framework polari-platform-angular
          ls polari-rf-node/polari-framework/Dockerfile polari-rf-node/polari-platform-angular/Dockerfile'''
        script {
          env.TEST_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
          env.RUN_DIR  = "${env.POOL}/test/${env.TEST_SHA}"
          echo "the tip of test is ${env.TEST_SHA}"
        }
      }
    }

    // ------------------------------------------------ 2. the WHOLE forest, confirmed
    // The expensive half, and the one that catches a submodule that moved while
    // the superproject stood still. A "no" here sets PROCEED=no; every stage
    // below is guarded on it and `post` stamps NOT_BUILT.
    stage('has the whole forest stopped moving?') {
      when { expression { env.PROCEED == 'gate' } }
      steps {
        script {
          env.PROCEED = 'no'
          def rc = sh(returnStatus: true,
                      script: "set +e; POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh check test > .quiet-check.log 2>&1; rc=\$?; cat .quiet-check.log; exit \$rc")
          if (rc == 6) {
            env.DEFER_WHY = 'changes still landing in a submodule — a promotion that is still pushing must ' +
                            'not be built half-way; the single pending item stays and the next tick picks ' +
                            'up the newest state.'
            echo env.DEFER_WHY
            return
          }
          if (rc != 0) {
            error("quiet.sh could not read the forest (rc=${rc}) — a run that cannot tell whether the branch is settled must not build")
          }
          env.QUIET_SHA = sh(returnStdout: true,
                             script: "sed -n 's/^QUIET_SHA=//p' .quiet-check.log | head -1").trim()
          if (env.QUIET_SHA && env.QUIET_SHA != env.TEST_SHA) {
            echo "note: the tip moved between the checkout and the quiet check (${env.TEST_SHA} → ${env.QUIET_SHA}). " +
                 "Testing what was checked out and recording ITS sha; the next poll will see the newer one."
          }
          env.PROCEED = 'yes'
          sh "POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh claim test '${env.TEST_SHA}'"
          sh "bash /var/polari-jenkins/cicd-sync.sh run test \"\$BUILD_NUMBER\" running '${env.TEST_SHA}' 'wipe, build, scan, test' || true"
        }
      }
    }

    // ci-8: Polari owns this device's settings; device.env is the fallback. Non-fatal.
    stage('sync settings from Polari (non-fatal)') {
      when { expression { env.PROCEED == 'yes' } }
      steps { sh 'bash /var/polari-jenkins/cicd-sync.sh pull || true' }
    }

    stage('disk guard') {
      when { expression { env.PROCEED == 'yes' } }
      steps { sh 'bash /var/polari-jenkins/retention.sh guard' }
    }

    // ----------------------------------------------------------------- 2. the WIPE
    stage('wipe what we have locally') {
      when { expression { env.PROCEED == 'yes' } }
      steps { sh "bash /var/polari-jenkins/test-wipe.sh '${env.RUN_DIR}' '${env.TEST_SHA}'" }
    }

    // ----------------------------------------------------------------- 3. the BUILD
    // Exactly what polari-dev-build does — the same builders, the same jmods JDK,
    // the same ci-9 cache. A test run that built differently from a dev build
    // would be testing a different artifact from the one anybody ships.
    stage('build — debs (isle bundle + both flavors)') {
      when { expression { env.PROCEED == 'yes' } }
      environment {
        JAVA_HOME = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}"
        PATH = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}/bin:${env.PATH}"
      }
      steps {
        sh '''set -eu
          echo "[debs] build JDK $(jpackage --version) at $JAVA_HOME — $(ls "$JAVA_HOME/jmods" | wc -l) jmods"
          export POLARI_WHEEL_CACHE="$(bash /var/polari-jenkins/cache.sh dir wheels)"
          export POLARI_APT_CACHE="$(bash /var/polari-jenkins/cache.sh dir apt)"
          T0=$(date +%s)
          bash ./build-polari-isle-deb.sh
          bash ./build-polari-complete-deb.sh --flavor online
          bash ./build-polari-complete-deb.sh --flavor offline
          ls -la .generated/debs
          mkdir -p "$RUN_DIR/debs" && cp .generated/debs/*.deb "$RUN_DIR/debs/"
          bash /var/polari-jenkins/cache.sh report "$RUN_DIR/cache-report.json" debs 0 0 $(( $(date +%s) - T0 ))'''
      }
    }
    stage('build — images') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        sh '''set -eu
          bash /var/polari-jenkins/build-images.sh "$PWD" "$RUN_DIR/cache-report.json"
          docker images --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep -E "^(prf-|pol-reticulum)"
          bash /var/polari-jenkins/cache.sh report-show "$RUN_DIR/cache-report.json" || true'''
      }
    }

    // ------------------------------------------------------------------ 4. the SCANS
    // scn-0. ADVISORY, and the stage says so in its own name so nobody reads a
    // red mark into it. catchError keeps even a catastrophic scanner failure from
    // touching the build's result; scan.sh already exits 0 on its own.
    stage('scan (ADVISORY — no finding gates anything)') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
          sh '''set +e
            bash /var/polari-jenkins/scan/scan.sh source --out "$RUN_DIR/scan"
            bash /var/polari-jenkins/scan/scan.sh deps   --out "$RUN_DIR/scan"
            bash /var/polari-jenkins/scan/scan.sh images --out "$RUN_DIR/scan"
            bash /var/polari-jenkins/scan/scan.sh debs   --out "$RUN_DIR/scan" "$RUN_DIR/debs"
            bash /var/polari-jenkins/scan/scan.sh summary --out "$RUN_DIR/scan"
            head -40 "$RUN_DIR/scan/SCAN_SUMMARY.md" 2>/dev/null
            exit 0'''
        }
      }
    }

    // ------------------------------------------- 5a. the tests that need no isle
    // Every module named in CI_ISLE_STAGES, plus `core` = the framework's own
    // packages. They run in the image the build stage just made, so they test
    // THIS sha's code. A failing suite is recorded, not thrown.
    stage('test — module selftests (no isle needed)') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          sh '''set -eu
            MODS="core $(bash -c '. /var/polari-jenkins/device.sh; stages_all_apps' | tr '\\n' ' ')"
            echo "[test] modules configured for this run: $MODS"
            bash /var/polari-jenkins/selftests.sh "$RUN_DIR/selftests" $MODS'''
        }
      }
    }

    // ------------------------------------------- 5a'. the proofs (ADVISORY, plan COMPUTE_LOD_TENSOR §I.9)
    // Every MathClaim through its cheapest tier in the image just built; the
    // Lean certificates only where this device resolves a checker and only the
    // files that changed. A red verdict is recorded for the report, never a
    // build failure — the scans' rule, until he says otherwise.
    stage('proofs (ADVISORY — a red verdict is recorded, not enforced)') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
          sh '''set +e
            bash /var/polari-jenkins/proofs.sh "$RUN_DIR/proofs"
            exit 0'''
        }
      }
    }

    // ------------------------------------------- 5b. the tests that DO need an isle
    // The stage loop is polari-isle-test's, unchanged and not copied: it is the
    // one implementation of preflight → up → install+test (ci-3) → uninstall →
    // down → leakcheck, and it writes results.json where the verdict reads it.
    // propagate:false — a failed stage must still leave its results behind; the
    // verdict decides, not the inner job's colour.
    stage('test — the throwaway isle stages') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          build job: 'polari-isle-test', wait: true, propagate: false,
                parameters: [string(name: 'VERSION', value: "test/${env.TEST_SHA}")]
        }
        sh 'ls -la "$RUN_DIR/isle-test" 2>/dev/null || echo "[test] no isle-test results for this sha"'
      }
    }

    // ---------------------------------------------------------------- 6. THE VERDICT
    stage('the verdict') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        sh '''set -eu
          python3 /var/polari-jenkins/verdict.py build "$RUN_DIR" \
            --sha "$TEST_SHA" --branch test --built true \
            --run "$JOB_NAME#$BUILD_NUMBER" --device "${CI_DEVICE_NAME:-pipeline}"
          cp "$RUN_DIR/verdict.json" verdict.json
          # 2026-09-22: a PASSED verdict's images are the release candidate — kept (docker save) so the
          # release LOADS the tested images instead of rebuilding different ones. Any other verdict keeps
          # nothing (ci-13: test images are discarded).
          bash /var/polari-jenkins/tested-images.sh keep "$RUN_DIR"'''
        // ci-3: ONE PAGE PER COMMIT, rendered from the run's own readings and
        // published as a release asset by routes/github-release.sh. It re-derives
        // nothing — the verdict line in it is quoted from the file above.
        sh '''set -eu
          python3 /var/polari-jenkins/report.py build "$RUN_DIR"
          cp "$RUN_DIR/TEST_REPORT.md" TEST_REPORT.md
          sed -n "1,40p" TEST_REPORT.md'''
        // ci-8/ci-12: the verdict is mirrored into the cicd app as its own kind.
        sh 'bash /var/polari-jenkins/cicd-sync.sh verdict "$RUN_DIR/verdict.json" "$JOB_NAME#$BUILD_NUMBER" || true'
        // …and ONLY now is this state "already covered". `done` in post runs for
        // an aborted or failed run too, and marking the state there meant an
        // abort silently retired a sha that had never been tested (polari-test
        // #11 on the pipeline device).
        sh "bash /var/polari-jenkins/quiet.sh covered test '${env.TEST_SHA}'"
      }
      post {
        always { archiveArtifacts artifacts: 'verdict.json,TEST_REPORT.md', allowEmptyArchive: true }
      }
    }
  }
  post {
    always {
      script {
        if (env.PROCEED != 'yes') {
          // "there was nothing to do" is NOT_BUILT, not FAILURE — the difference
          // matters, because a red build on a deferral would train people to
          // ignore red builds.
          currentBuild.result = 'NOT_BUILT'
          echo "DEFERRED: ${env.DEFER_WHY ?: 'the run did not proceed'}"
        } else {
          sh "POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh turn-done test || true"
          // rule 4: the result travels — a FAILED run is not re-run by a tick; it waits for a re-push or a
          // manual run (quiet.sh).
          sh "bash /var/polari-jenkins/quiet.sh done test '${env.TEST_SHA ?: ''}' ${currentBuild.currentResult.toLowerCase()} || true"
          // ci-13 (his ruling): the images this TEST run built are discarded now — only a release keeps
          // images. The pool run dir (verdict, report, logs) stays; CI_KEEP_TEST_IMAGES=1 keeps the images.
          sh "if [ \"\${CI_KEEP_TEST_IMAGES:-0}\" = 1 ]; then echo 'CI_KEEP_TEST_IMAGES=1 — the test images are kept'; else bash /var/polari-jenkins/test-wipe.sh --images-only '${env.RUN_DIR ?: '/nonexistent'}' '${env.TEST_SHA ?: ''}' || true; fi"
          // NOT readJSON: it comes from pipeline-utility-steps, which is not in
          // casc/plugins.txt and has never been installed here. It threw
          // NoSuchMethodError in this very block on the first complete run —
          // AFTER the verdict had been written — and turned a recorded verdict
          // into a red build. jsonget.py needs no plugin.
          def v = 'not reached'
          if (env.RUN_DIR && fileExists("${env.RUN_DIR}/verdict.json")) {
            v = sh(returnStdout: true,
                   script: "python3 ${JSONGET} '${env.RUN_DIR}/verdict.json' verdict --default 'not reached'").trim()
          }
          sh "bash /var/polari-jenkins/cicd-sync.sh run test \"\$BUILD_NUMBER\" ${currentBuild.currentResult.toLowerCase()} '${env.TEST_SHA ?: ''}' 'test verdict: ${v}' || true"
          echo "TEST VERDICT for ${env.TEST_SHA ?: '(no sha)'}: ${v}  —  pol jenkins test-status ${env.TEST_SHA ?: ''}"
          sh 'bash /var/polari-jenkins/retention.sh prune || true'
        }
      }
      cleanWs()
    }
  }
}
