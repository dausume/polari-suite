// polari-release — main → pool/<version>/ (debs, images as tarballs + digests, release.json, offline medium). No publish here.
//
// ci-12 — THE SECOND OF TWO PIPELINES (his ruling 2026-09-19: "When a push to
// main occurs, we kick off the generation of artifacts and publish the
// artifacts. The test and main pipelines should likely be different pipelines.").
//
// WHAT CHANGED. This job no longer RUNS the tests. It reads the verdict the
// TEST pipeline already recorded for the sha being released —
// pool/test/<sha>/verdict.json must say `passed` — and every publish route
// refuses independently (routes/_lib.sh) if it does not. Results are CARRIED
// OVER, never re-derived: re-running the isle stages here would test a
// different moment from the one the decision to promote was made on, and the
// whole point of the branch model is that the thing released is the thing
// tested.
//
// It is also NOT PARAMETERISED on the poll path, so Jenkins coalesces its queued
// items and no backlog can form; polari-release-manual carries the two knobs.
pipeline {
  agent any
  options { timestamps(); timeout(time: 180, unit: 'MINUTES'); disableConcurrentBuilds(); lock(resource: 'polari-build') }  // never overlaps a dev build or a test run (same daemon, same staging tags)
  environment { POOL = "${env.POLARI_POOL ?: '/var/polari-pool'}" }
  stages {
    // ci-8: the settings come from the `cicd` Polari app (non-fatal pull), and the run is mirrored back.
    stage('sync settings from Polari (non-fatal)') {
      steps { sh 'bash /var/polari-jenkins/cicd-sync.sh pull || true' }
    }
    stage('disk guard') { steps { sh 'bash /var/polari-jenkins/retention.sh guard' } }
    stage('checkout main (top-level submodules only)') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/main']],
                  userRemoteConfigs: [[url: 'https://github.com/dausume/polari-suite.git']],
                  extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: false, parentCredentials: false, shallow: true]]])
        // ci-7: the version IS the tag name (POLARI_VERSIONING_PLAN §2) — polari-vYYYY.MM.DD, .N for a
        // second release the same day. The old 'YYYY.MM.DD+<sha>' minted the malformed tag polari-v…+sha;
        // the sha lives in release.json, where every component sha already is.
        script {
          env.POLARI_VERSION = sh(returnStdout: true, script: 'bash /var/polari-jenkins/mint-tag.sh').trim()
          env.POLARI_TAG     = "polari-v${env.POLARI_VERSION}"
          env.POLARI_SHA     = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
          env.POLARI_FULL_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
        }
      }
    }

    // ci-12 — the same two questions polari-test asks, and the same cheap yield.
    // It runs AFTER the checkout because the quiet check reads every top-level
    // submodule REMOTE, and the only place those are written down is the
    // checkout's own .gitmodules. A "no" sets PROCEED=no; every stage below is
    // guarded on it and `post` stamps NOT_BUILT — "there was nothing to do" is
    // not a red build.
    stage('whose turn is it, and has the forest stopped moving?') {
      steps {
        script {
          env.PROCEED = 'no'
          def turn = sh(returnStatus: true,
                        script: "POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh turn release --once")
          if (turn == 7) {
            env.DEFER_WHY = 'yielding to polari-test — it has something pending and main ran last. The pending main item is untouched.'
            echo env.DEFER_WHY
            return
          }
          def out = sh(returnStdout: true, script: """set +e
            POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh check main
            echo "QUIET_RC=\$?" """)
          echo out
          def m = (out =~ /QUIET_RC=(\d+)/)
          def rc = m ? (m[0][1] as int) : 1
          if (rc == 6) {
            env.DEFER_WHY = 'changes still landing on main — re-polled. A promotion that is still pushing must not be released half-way.'
            echo env.DEFER_WHY
            return
          }
          if (rc != 0) { error("quiet.sh could not read the forest (rc=${rc})") }
          env.PROCEED = 'yes'
          sh "POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh claim main '${env.POLARI_FULL_SHA}'"
          sh "bash /var/polari-jenkins/cicd-sync.sh run release \"\$BUILD_NUMBER\" running '' 'release build' || true"
        }
      }
    }

    // the images stage builds polari-rf-node's two nested submodules, which the
    // non-recursive checkout above leaves empty — init exactly those two (both https;
    // Isle-Mesh's ssh-URL nesting stays untouched, which is why there is no --recursive).
    // Guarded: a DEFERRED run must not create an empty pool version for a build it
    // is not going to do.
    stage('the two nested submodules, and the pool directory') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        sh '''set -eu
          git -C polari-rf-node submodule update --init --depth 1 polari-framework polari-platform-angular
          echo "Polari version: $POLARI_VERSION  tag: $POLARI_TAG  sha: $POLARI_SHA"
          mkdir -p "$POOL/$POLARI_VERSION"'''
      }
    }
    // -------------------------------------------------------------------
    // ci-9, app mode (his addendum 2026-09-19): a device that maintains ONE
    // app does NOT build the core. Its debs come from an official Polari
    // release, fetched ONCE into the cache and verified against that release's
    // SHA256SUMS; the app is tested against THAT core and the record says so.
    // CI_CORE_SOURCE=build is the escape hatch for somebody who also patches
    // core — then the stages below run as they always did.
    // -------------------------------------------------------------------
    stage('the core — pulled from a release (app mode)') {
      when { expression { env.PROCEED == 'yes' && ((env.CI_MODE == 'app') || (env.CI_CORE_SOURCE ?: '').startsWith('release:')) } }
      steps {
        script {
          def out = sh(returnStdout: true, script: 'CACHE_REPORT="$POOL/$POLARI_VERSION/cache-report.json" bash /var/polari-jenkins/isle/core-artifacts.sh fetch').trim()
          env.CORE_TAG  = (out =~ /CORE_TAG=(\S+)/) ? (out =~ /CORE_TAG=(\S+)/)[0][1] : ''
          env.CORE_DEBS = (out =~ /CORE_DEBS=(\S+)/) ? (out =~ /CORE_DEBS=(\S+)/)[0][1] : ''
          echo "core: ${env.CORE_TAG ?: 'built here (CI_CORE_SOURCE=build)'}  ${env.CORE_DEBS ?: ''}"
        }
      }
    }

    stage('debs') {
      when { expression { env.PROCEED == 'yes' } }
      // same reason as dev-build: jpackage/jlink need the jmods-bearing JDK, stage-scoped only.
      environment {
        JAVA_HOME = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}"
        PATH = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}/bin:${env.PATH}"
      }
      steps {
        sh '''set -eu
          mkdir -p "$POOL/$POLARI_VERSION/debs"
          # ci-9: the builders read the offline cache first (wheels, distro debs)
          export POLARI_WHEEL_CACHE="$(bash /var/polari-jenkins/cache.sh dir wheels)"
          export POLARI_APT_CACHE="$(bash /var/polari-jenkins/cache.sh dir apt)"
          T0=$(date +%s)
          if [ "${CI_MODE:-suite}" = app ] && [ -n "${CORE_DEBS:-}" ]; then
            # app mode: ONLY this device's app is built. The core debs are the
            # release's, copied in so the isle stage installs exactly what the
            # app was tested against — they are NOT re-released (see the routes).
            echo "[release] app mode: building ONLY ${CI_APP_NAME} — the core is ${CORE_TAG}"
            cp "$CORE_DEBS"/*.deb "$POOL/$POLARI_VERSION/debs/"
            bash /var/polari-jenkins/isle/app-debs.sh "$POOL/$POLARI_VERSION/debs" "$CI_APP_NAME"
          else
            bash ./build-polari-isle-deb.sh
            bash ./build-polari-complete-deb.sh --flavor online
            bash ./build-polari-complete-deb.sh --flavor offline
            cp .generated/debs/*.deb "$POOL/$POLARI_VERSION/debs/"
          fi
          bash /var/polari-jenkins/cache.sh report "$POOL/$POLARI_VERSION/cache-report.json" debs 0 0 $(( $(date +%s) - T0 ))'''
      }
    }
    stage('images') {
      // app mode releases a deb, not images: the core images belong to the
      // release the app was tested against and are never rebuilt or republished.
      when { expression { env.PROCEED == 'yes' && (env.CI_MODE ?: 'suite') != 'app' } }
      steps {
        sh '''set -eu
              bash /var/polari-jenkins/build-images.sh "$PWD" "$POOL/$POLARI_VERSION/cache-report.json"
              mkdir -p "$POOL/$POLARI_VERSION/images"
              for ref in prf-backend:staging prf-frontend:staging pol-reticulum:staging; do
                docker tag "$ref" "${ref%%:*}:$POLARI_VERSION"
                docker save -o "$POOL/$POLARI_VERSION/images/${ref%%:*}_$POLARI_VERSION.tar" "${ref%%:*}:$POLARI_VERSION"
                docker image inspect --format "{{.Id}} ${ref%%:*}:$POLARI_VERSION" "$ref" >> "$POOL/$POLARI_VERSION/images/DIGESTS.txt"
              done
              bash /var/polari-jenkins/cache.sh report-show "$POOL/$POLARI_VERSION/cache-report.json" || true'''
      }
    }
    stage('images (app mode: none)') {
      when { expression { env.PROCEED == 'yes' && (env.CI_MODE ?: 'suite') == 'app' } }
      steps {
        sh '''mkdir -p "$POOL/$POLARI_VERSION/images"
              echo "app mode: no images are built or released here — the core images are ${CORE_TAG:-the core release}'\\''s" \
                   > "$POOL/$POLARI_VERSION/images/DIGESTS.txt"'''
      }
    }
    stage('release.json (the manifest: every component sha)') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        sh '''python3 - "$POOL/$POLARI_VERSION" "$POLARI_VERSION" <<'PY'
import json, os, subprocess, sys, datetime
pool, ver = sys.argv[1:3]
env = os.environ.get
sha = lambda p: subprocess.check_output(['git', '-C', p, 'rev-parse', 'HEAD'], text=True).strip()
comps = {k: {'sha': sha(p)} for k, p in {'superproject': '.', 'polari-framework': 'polari-rf-node/polari-framework',
         'polari-platform-angular': 'polari-rf-node/polari-platform-angular', 'isle-mesh': 'Isle-Mesh',
         'app-shell': 'polari-app-shell', 'pol-cli': 'polari-cli'}.items() if os.path.isdir(p)}
mode = env('CI_MODE', 'suite')
digests = os.path.join(pool, 'images', 'DIGESTS.txt')
m = {'polari': ver, 'builtAt': datetime.datetime.now().isoformat(timespec='seconds'),
     # his privacy rule: the building machine's hostname NEVER reaches a file a
     # release publishes. The device's chosen name, or nothing.
     'builtOn': env('CI_DEVICE_NAME', 'pipeline'),
     'mode': mode, 'appName': env('CI_APP_NAME', ''), 'routeTarget': env('CI_ROUTE_TARGET', ''),
     # ci-9: the CORE this build was tested against. In app mode it is the
     # official release whose debs were pulled; in suite mode it is this build.
     'testedAgainst': (env('CORE_TAG', '') or env('CI_CORE_SOURCE', '')) if mode == 'app' else ('release:polari-v%s' % ver),
     'components': comps, 'debs': sorted(os.listdir(os.path.join(pool, 'debs'))),
     'images': open(digests).read().split() if os.path.exists(digests) else [], 'publishedTo': {}}
try:
    m['cacheReport'] = json.load(open(os.path.join(pool, 'cache-report.json')))
except Exception:
    m['cacheReport'] = {}
json.dump(m, open(os.path.join(pool, 'release.json'), 'w'), indent=1); print(json.dumps(m, indent=1))
PY'''
      }
    }
    stage('offline medium') {
      // ci-12: a DEVICE knob on the poll path (the job takes no parameters so its
      // queued items coalesce); polari-release-manual still exposes it as one.
      when { expression { env.PROCEED == 'yes' && ((params.BUILD_OFFLINE_MEDIUM != null) ? params.BUILD_OFFLINE_MEDIUM : ((env.CI_BUILD_OFFLINE_MEDIUM ?: 'true') != 'false')) } }
      steps { sh 'bash ./build-offline-medium.sh --version "$POLARI_VERSION" --target ubuntu-22.04 && cp -r "offline-build/$POLARI_VERSION" "$POOL/$POLARI_VERSION/offline"' }
    }
    stage('checksums') {
      when { expression { env.PROCEED == 'yes' } }
      steps { sh 'cd "$POOL/$POLARI_VERSION" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS && wc -l SHA256SUMS' }
    }

    // ---------------------------------------------------------------------
    // THE RELEASE RULE, ci-12 SHAPE. It used to run polari-isle-test here. It
    // now reads what the TEST pipeline recorded for THIS SHA and nothing else:
    //
    //     pool/test/<sha>/verdict.json   verdict == 'passed'
    //
    // "Only what was tested is released" is the same rule it always was; what
    // changed is WHERE the testing happened — on the test branch, before the
    // decision to promote was made, which is the point of having the branch.
    // A sha with no verdict, or a verdict of `failed` / `partial`, builds into
    // the pool and publishes NOTHING: the tag is not pushed and every route
    // prints its own DRY line naming the missing verdict (routes/_lib.sh
    // enforces it independently, so triggering polari-publish by hand is safe).
    // ---------------------------------------------------------------------
    stage('the test verdict — only what was TESTED is released') {
      when { expression { env.PROCEED == 'yes' } }
      steps {
        script {
          def vf = "${env.POOL}/test/${env.POLARI_FULL_SHA}/verdict.json"
          if (!fileExists(vf)) {
            env.RELEASE_TESTED = 'no'
            echo "NOT RELEASED: there is no test verdict for ${env.POLARI_FULL_SHA}. This sha was never run through " +
                 "polari-test — push it to `test` first (pol jenkins promote test), let polari-test record a verdict, " +
                 "then promote main. The build stays in the pool, the tag is NOT pushed and every route will stay DRY."
          } else {
            def v = readJSON file: vf
            env.RELEASE_TESTED  = (v.verdict == 'passed') ? 'yes' : 'no'
            env.RELEASE_VERDICT = v.verdict
            sh "cp '${vf}' verdict.json"
            echo "test verdict for ${env.POLARI_FULL_SHA}: ${v.verdict} — ${v.why}"
            echo "  selftests: ${v.selftests?.passed ?: 0} pass / ${v.selftests?.failed ?: 0} fail" +
                 "   isle core_ok=${v.isle?.core_ok}   scans (advisory): ${v.scans?.totals}"
            if (v.verdict != 'passed') {
              echo "NOT RELEASED: the verdict is '${v.verdict}', not 'passed'. Nothing is published and the tag is not pushed."
            }
          }
        }
      }
      post { always { archiveArtifacts artifacts: 'verdict.json', allowEmptyArchive: true } }
    }

    // ci-7 (C): the tag is pushed ONLY when the credential that may push is present. Without it the job
    // says which tag it WOULD have made and carries on in dry — a release never depends on a secret
    // being there, and no secret is ever printed (Jenkins masks the bound values).
    // ci-7b: and only when the isle test passed core — an untagged, unpublished build is the honest
    // outcome of an untested one.
    stage('tag the superproject') {
      when { expression { env.PROCEED == 'yes' && env.RELEASE_TESTED == 'yes' } }
      steps {
        withCredentials([string(credentialsId: 'github_token', variable: 'GITHUB_TOKEN'),
                         string(credentialsId: 'github_ssh_key', variable: 'GITHUB_SSH_KEY')]) {
          sh '''set -eu
            REPO=dausume/polari-suite
            if [ -n "${GITHUB_TOKEN:-}" ]; then
              git tag -a "$POLARI_TAG" -m "Polari $POLARI_VERSION"
              git push "https://x-access-token:$GITHUB_TOKEN@github.com/$REPO.git" "refs/tags/$POLARI_TAG"
              echo "[tag] pushed $POLARI_TAG (contents:write via github/github_token)"
            elif [ -n "${GITHUB_SSH_KEY:-}" ]; then
              K=$(mktemp); printf '%s\\n' "$GITHUB_SSH_KEY" > "$K"; chmod 0600 "$K"
              git tag -a "$POLARI_TAG" -m "Polari $POLARI_VERSION"
              GIT_SSH_COMMAND="ssh -i $K -o StrictHostKeyChecking=accept-new" git push "git@github.com:$REPO.git" "refs/tags/$POLARI_TAG"
              rm -f "$K"; echo "[tag] pushed $POLARI_TAG (github/github_ssh_key)"
            else
              echo "[tag] DRY: would have made and pushed $POLARI_TAG at $POLARI_SHA — neither github/github_token nor github/github_ssh_key is present (pol jenkins secrets put github/github_token)"
            fi'''
        }
      }
    }
    // ci-8: the release RECORD — what shipped, what did not and why, and (app mode) the CORE release it
    // was tested against. Mirrored in with the posting-only credential; never fatal.
    stage('mirror the release record into Polari') {
      when { expression { env.PROCEED == 'yes' } }
      steps { sh 'bash /var/polari-jenkins/cicd-sync.sh release "$POLARI_VERSION" "$POOL/$POLARI_VERSION/release.json" || true' }
    }
    stage('not released (untested)') {
      when { expression { env.PROCEED == 'yes' && env.RELEASE_TESTED != 'yes' } }
      steps { echo 'not released: this sha has no PASSED test verdict. The build stays in the pool, the tag is not pushed, and polari-publish is still triggered — every route prints its own DRY line naming the missing verdict. The fix is not to re-run anything here: promote the sha to `test`, let polari-test record a passing verdict, then promote main.' }
    }
  }
  post {
    // ci-8: the run's outcome, mirrored in (never fatal, never a Jenkins credential)
    // ci-9: the run's summary now carries the cache arithmetic, so "did the
    // cache help?" is answerable from the PipelineRun rows without a log dive.
    // ONE `always` block: declarative pipeline refuses a duplicate condition name — the first real run on the
    // pipeline device (2026-09-19, §75) failed to COMPILE with "Duplicate build condition name: always".
    always {
      script {
        if (env.PROCEED != 'yes') {
          currentBuild.result = 'NOT_BUILT'
          echo "DEFERRED: ${env.DEFER_WHY ?: 'the run did not proceed'}"
        }
      }
      sh "POLARI_SUITE='${env.WORKSPACE}' bash /var/polari-jenkins/quiet.sh turn-done release || true"
      sh 'bash /var/polari-jenkins/quiet.sh done main "${POLARI_FULL_SHA:-}" || true'
      script { sh "bash /var/polari-jenkins/cicd-sync.sh run release \"\$BUILD_NUMBER\" ${currentBuild.currentResult.toLowerCase()} \"\${POLARI_VERSION:-}\" \"release build — \$(bash /var/polari-jenkins/cache.sh report-show \"\$POOL/\${POLARI_VERSION:-none}/cache-report.json\" 2>/dev/null | head -1 || echo 'no cache report')\" || true" }
      sh 'bash /var/polari-jenkins/retention.sh prune || true'
      cleanWs()
    }
    // ci-7: DRY_RUN=auto — each route publishes for real only when its secret is present AND it is
    // named in CI_ROUTES (device.env). Nothing is armed by being triggered.
    // ci-12: and the routes re-read pool/test/<sha>/verdict.json themselves (routes/_lib.sh), so triggering
    // publish on an untested build is safe — every route renders and says why.
    success { script { if (env.PROCEED == 'yes') { build job: 'polari-publish', wait: false, parameters: [string(name: 'VERSION', value: env.POLARI_VERSION), string(name: 'DRY_RUN', value: 'auto'), string(name: 'ROUTES', value: env.CI_ROUTES ?: 'github-release,ghcr,homebrew,apt-repo')] } } }
  }
}
