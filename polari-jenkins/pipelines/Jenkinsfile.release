// polari-release — main → pool/<version>/ (debs, images as tarballs + digests, release.json, offline medium). No publish here.
pipeline {
  agent any
  options { timestamps(); timeout(time: 180, unit: 'MINUTES'); disableConcurrentBuilds(); lock(resource: 'polari-build') }  // never overlaps a dev build (same daemon, same staging tags)
  environment { POOL = "${env.POLARI_POOL ?: '/var/polari-pool'}" }
  stages {
    stage('disk guard') { steps { sh 'bash /var/polari-jenkins/retention.sh guard' } }
    stage('checkout main (top-level submodules only)') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/main']],
                  userRemoteConfigs: [[url: 'https://github.com/dausume/polari-suite.git']],
                  extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: false, parentCredentials: false, shallow: true]]])
        // ci-7: the version IS the tag name (POLARI_VERSIONING_PLAN §2) — polari-vYYYY.MM.DD, .N for a
        // second release the same day. The old 'YYYY.MM.DD+<sha>' minted the malformed tag polari-v…+sha;
        // the sha lives in release.json, where every component sha already is.
        script {
          env.POLARI_VERSION = sh(returnStdout: true, script: 'bash /var/polari-jenkins/mint-tag.sh').trim()
          env.POLARI_TAG     = "polari-v${env.POLARI_VERSION}"
          env.POLARI_SHA     = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        }
        sh 'echo "Polari version: $POLARI_VERSION  tag: $POLARI_TAG  sha: $POLARI_SHA"; mkdir -p "$POOL/$POLARI_VERSION"'
      }
    }
    stage('debs') {
      steps { sh 'bash ./build-polari-isle-deb.sh && bash ./build-polari-complete-deb.sh --flavor online && bash ./build-polari-complete-deb.sh --flavor offline && mkdir -p "$POOL/$POLARI_VERSION/debs" && cp .generated/debs/*.deb "$POOL/$POLARI_VERSION/debs/"' }
    }
    stage('images') {
      steps {
        sh '''cd polari-rf-node && docker compose -f docker-compose.yml build backend frontend && docker compose -f docker-compose.reticulum.yml build
              mkdir -p "$POOL/$POLARI_VERSION/images"
              for ref in prf-backend:staging prf-frontend:staging pol-reticulum:staging; do
                docker tag "$ref" "${ref%%:*}:$POLARI_VERSION"
                docker save -o "$POOL/$POLARI_VERSION/images/${ref%%:*}_$POLARI_VERSION.tar" "${ref%%:*}:$POLARI_VERSION"
                docker image inspect --format "{{.Id}} ${ref%%:*}:$POLARI_VERSION" "$ref" >> "$POOL/$POLARI_VERSION/images/DIGESTS.txt"
              done'''
      }
    }
    stage('release.json (the manifest: every component sha)') {
      steps {
        sh '''python3 - "$POOL/$POLARI_VERSION" "$POLARI_VERSION" <<'PY'
import json, os, subprocess, sys, datetime, socket
pool, ver = sys.argv[1:3]
sha = lambda p: subprocess.check_output(['git', '-C', p, 'rev-parse', 'HEAD'], text=True).strip()
comps = {k: {'sha': sha(p)} for k, p in {'superproject': '.', 'polari-framework': 'polari-rf-node/polari-framework',
         'polari-platform-angular': 'polari-rf-node/polari-platform-angular', 'isle-mesh': 'Isle-Mesh',
         'app-shell': 'polari-app-shell', 'pol-cli': 'polari-cli'}.items() if os.path.isdir(p)}
m = {'polari': ver, 'builtAt': datetime.datetime.now().isoformat(timespec='seconds'), 'builtOn': socket.gethostname(),
     'components': comps, 'debs': sorted(os.listdir(os.path.join(pool, 'debs'))),
     'images': open(os.path.join(pool, 'images', 'DIGESTS.txt')).read().split(), 'publishedTo': {}}
json.dump(m, open(os.path.join(pool, 'release.json'), 'w'), indent=1); print(json.dumps(m, indent=1))
PY'''
      }
    }
    stage('offline medium') {
      when { expression { return params.BUILD_OFFLINE_MEDIUM } }
      steps { sh 'bash ./build-offline-medium.sh --version "$POLARI_VERSION" --target ubuntu-22.04 && cp -r "offline-build/$POLARI_VERSION" "$POOL/$POLARI_VERSION/offline"' }
    }
    stage('checksums') { steps { sh 'cd "$POOL/$POLARI_VERSION" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS && wc -l SHA256SUMS' } }

    // ---------------------------------------------------------------------
    // THE RELEASE RULE (his ask 2026-09-19): "The pipeline should only
    // generate artifact for things that are tested." So the isle test runs
    // HERE, on the version just built, before anything leaves this machine.
    //
    // Jenkins shape, chosen for being the simplest that works: a plain
    // `build job: … wait: true` step. No upstream/downstream plumbing, no
    // fingerprint matching — polari-isle-test is a normal job, it takes the
    // VERSION, and it writes pool/<version>/isle-test/results.json where the
    // gate below and every publish route read it. propagate:false because a
    // failed stage must still leave its results behind: the gate decides
    // what may ship, not the job's colour.
    // ---------------------------------------------------------------------
    stage('isle test — only what is tested may be released') {
      steps {
        build job: 'polari-isle-test', wait: true, propagate: false,
              parameters: [string(name: 'VERSION', value: env.POLARI_VERSION)]
        script {
          def rf = "${env.POOL}/${env.POLARI_VERSION}/isle-test/results.json"
          if (!fileExists(rf)) {
            env.RELEASE_TESTED = 'no'
            echo "NOT RELEASED: no isle-test results for ${env.POLARI_VERSION} — the pipeline only releases what it tested. The tag is NOT pushed and every route will stay DRY."
          } else {
            def r = readJSON file: rf
            env.RELEASE_TESTED = r.core_ok ? 'yes' : 'no'
            echo "isle test: core_ok=${r.core_ok} · passed=${r.passed} · untested/failed=${r.untested}"
            if (!r.core_ok) echo "NOT RELEASED: the isle test did not record core_ok — nothing is published and the tag is not pushed."
          }
        }
      }
      post { always { archiveArtifacts artifacts: "isle-test/results.json", allowEmptyArchive: true } }
    }

    // ci-7 (C): the tag is pushed ONLY when the credential that may push is present. Without it the job
    // says which tag it WOULD have made and carries on in dry — a release never depends on a secret
    // being there, and no secret is ever printed (Jenkins masks the bound values).
    // ci-7b: and only when the isle test passed core — an untagged, unpublished build is the honest
    // outcome of an untested one.
    stage('tag the superproject') {
      when { environment name: 'RELEASE_TESTED', value: 'yes' }
      steps {
        withCredentials([string(credentialsId: 'github_token', variable: 'GITHUB_TOKEN'),
                         string(credentialsId: 'github_ssh_key', variable: 'GITHUB_SSH_KEY')]) {
          sh '''set -eu
            REPO=dausume/polari-suite
            if [ -n "${GITHUB_TOKEN:-}" ]; then
              git tag -a "$POLARI_TAG" -m "Polari $POLARI_VERSION"
              git push "https://x-access-token:$GITHUB_TOKEN@github.com/$REPO.git" "refs/tags/$POLARI_TAG"
              echo "[tag] pushed $POLARI_TAG (contents:write via github/github_token)"
            elif [ -n "${GITHUB_SSH_KEY:-}" ]; then
              K=$(mktemp); printf '%s\\n' "$GITHUB_SSH_KEY" > "$K"; chmod 0600 "$K"
              git tag -a "$POLARI_TAG" -m "Polari $POLARI_VERSION"
              GIT_SSH_COMMAND="ssh -i $K -o StrictHostKeyChecking=accept-new" git push "git@github.com:$REPO.git" "refs/tags/$POLARI_TAG"
              rm -f "$K"; echo "[tag] pushed $POLARI_TAG (github/github_ssh_key)"
            else
              echo "[tag] DRY: would have made and pushed $POLARI_TAG at $POLARI_SHA — neither github/github_token nor github/github_ssh_key is present (pol jenkins secrets put github/github_token)"
            fi'''
        }
      }
    }
    stage('not released (untested)') {
      when { not { environment name: 'RELEASE_TESTED', value: 'yes' } }
      steps { echo 'not released: untested/failed. The build stays in the pool, the tag is not pushed, and polari-publish is still triggered — every route will print its own DRY line naming the missing results. Run polari-isle-test for this version, then re-run polari-publish.' }
    }
  }
  post {
    // ci-7: DRY_RUN=auto — each route publishes for real only when its secret is present AND it is
    // named in CI_ROUTES (device.env). Nothing is armed by being triggered.
    // ci-7b: and the routes re-read isle-test/results.json themselves (routes/_lib.sh), so triggering
    // publish on an untested build is safe — every route renders and says why.
    success { build job: 'polari-publish', wait: false, parameters: [string(name: 'VERSION', value: env.POLARI_VERSION), string(name: 'DRY_RUN', value: 'auto'), string(name: 'ROUTES', value: env.CI_ROUTES ?: 'github-release,ghcr,homebrew,apt-repo')] }
    always { sh 'bash /var/polari-jenkins/retention.sh prune || true'; cleanWs() }
  }
}
