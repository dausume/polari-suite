// polari-dev-build — build only (no tests yet, no publish)
pipeline {
  agent any
  // ONE dev build at a time (his rule 2026-09-08): a newer trigger ABORTS the running one (latest commit wins,
  // queued duplicates collapse), and the global 'polari-build' lock keeps dev-build/release/publish from overlapping.
  options { timestamps(); timeout(time: 120, unit: 'MINUTES'); disableConcurrentBuilds(abortPrevious: true); lock(resource: 'polari-build') }
  stages {
    // ci-8: the `cicd` Polari app owns this device's settings; device.env is the fallback. The pull is
    // NON-FATAL by design — a core that does not answer leaves the device.env this device already has,
    // and says so on one line, rather than stalling a build on a web service.
    stage('sync settings from Polari (non-fatal)') {
      steps { sh 'bash /var/polari-jenkins/cicd-sync.sh pull || true; bash /var/polari-jenkins/cicd-sync.sh run dev-build "$BUILD_NUMBER" running "" "build only, no publish" || true' }
    }
    stage('disk guard') { steps { sh 'bash /var/polari-jenkins/retention.sh guard' } }
    stage('checkout dev (top-level submodules — Isle-Mesh nests an ssh-URL submodule the poller cannot clone; the builders do not need it)') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/dev']],
                  userRemoteConfigs: [[url: 'https://github.com/dausume/polari-suite.git']],
                  extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: false, parentCredentials: false, trackingSubmodules: false, shallow: true]]])
        sh 'git rev-parse --short HEAD > .polari-sha; cat .polari-sha'
      }
    }
    // ci-9 (his ask 2026-09-19): the wheels, npm packages, distro debs and base
    // images a build needs come from the cache when they are there, and only the
    // genuinely-new ones are fetched. CI_CACHE=off in device.env turns all of it
    // off; an EMPTY cache still builds, over the network, and says so.
    stage('debs (isle bundle + both merged flavors)') {
      // The shell deb is jpackage'd, and jlink needs a JDK WITH jmods — the image's
      // own Temurin-layout JDK has none. POLARI_BUILD_JAVA_HOME (controller/Dockerfile)
      // is Debian's openjdk-21; it is scoped to THIS stage so Jenkins keeps its runtime.
      environment {
        JAVA_HOME = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}"
        PATH = "${env.POLARI_BUILD_JAVA_HOME ?: '/usr/lib/jvm/java-21-openjdk-amd64'}/bin:${env.PATH}"
      }
      steps {
        sh '''set -eu
          echo "[debs] build JDK $(jpackage --version) at $JAVA_HOME — $(ls "$JAVA_HOME/jmods" | wc -l) jmods"
          bash /var/polari-jenkins/cache.sh status | head -20
          export POLARI_WHEEL_CACHE="$(bash /var/polari-jenkins/cache.sh dir wheels)"
          export POLARI_APT_CACHE="$(bash /var/polari-jenkins/cache.sh dir apt)"
          T0=$(date +%s)
          bash ./build-polari-isle-deb.sh
          bash ./build-polari-complete-deb.sh --flavor online
          bash ./build-polari-complete-deb.sh --flavor offline
          ls -la .generated/debs
          bash /var/polari-jenkins/cache.sh report "$WORKSPACE/cache-report.json" debs 0 0 $(( $(date +%s) - T0 ))'''
      }
    }
    stage('images') {
      steps {
        sh '''set -eu
          bash /var/polari-jenkins/build-images.sh "$PWD" "$WORKSPACE/cache-report.json"
          docker images --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep -E "^(prf-|pol-reticulum)"
          bash /var/polari-jenkins/cache.sh report-show "$WORKSPACE/cache-report.json" || true'''
      }
    }
    // stage('tests') — deliberately absent (his ruling 2026-09-07); ci-3 adds the isle tests here.
  }
  post {
    always {
      archiveArtifacts artifacts: '.generated/debs/*.deb', fingerprint: true, allowEmptyArchive: true
      // ci-8: mirror the outcome into Polari (posting-only credential; nothing here drives Jenkins)
      // ci-9: the cache arithmetic rides in the run's summary
      script { sh "bash /var/polari-jenkins/cicd-sync.sh run dev-build \"\$BUILD_NUMBER\" ${currentBuild.currentResult.toLowerCase()} '' \"dev build — \$(bash /var/polari-jenkins/cache.sh report-show \"\$WORKSPACE/cache-report.json\" 2>/dev/null | head -1 || echo 'no cache report')\" || true" }
      sh 'bash /var/polari-jenkins/retention.sh prune || true'
      cleanWs()
    }
  }
}
