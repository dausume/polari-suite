// polari-dev-build — build only (no tests yet, no publish)
pipeline {
  agent any
  // ONE dev build at a time (his rule 2026-09-08): a newer trigger ABORTS the running one (latest commit wins,
  // queued duplicates collapse), and the global 'polari-build' lock keeps dev-build/release/publish from overlapping.
  options { timestamps(); timeout(time: 120, unit: 'MINUTES'); disableConcurrentBuilds(abortPrevious: true); lock(resource: 'polari-build') }
  stages {
    // ci-8: the `cicd` Polari app owns this device's settings; device.env is the fallback. The pull is
    // NON-FATAL by design — a core that does not answer leaves the device.env this device already has,
    // and says so on one line, rather than stalling a build on a web service.
    stage('sync settings from Polari (non-fatal)') {
      steps { sh 'bash /var/polari-jenkins/cicd-sync.sh pull || true; bash /var/polari-jenkins/cicd-sync.sh run dev-build "$BUILD_NUMBER" running "" "build only, no publish" || true' }
    }
    stage('disk guard') { steps { sh 'bash /var/polari-jenkins/retention.sh guard' } }
    stage('checkout dev (top-level submodules — Isle-Mesh nests an ssh-URL submodule the poller cannot clone; the builders do not need it)') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/dev']],
                  userRemoteConfigs: [[url: 'https://github.com/dausume/polari-suite.git']],
                  extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: false, parentCredentials: false, trackingSubmodules: false, shallow: true]]])
        sh 'git rev-parse --short HEAD > .polari-sha; cat .polari-sha'
      }
    }
    stage('debs (isle bundle + both merged flavors)') {
      steps { sh 'bash ./build-polari-isle-deb.sh && bash ./build-polari-complete-deb.sh --flavor online && bash ./build-polari-complete-deb.sh --flavor offline && ls -la .generated/debs' }
    }
    stage('images') {
      steps { sh 'cd polari-rf-node && docker compose -f docker-compose.yml build backend frontend && docker compose -f docker-compose.reticulum.yml build && docker images --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep -E "^(prf-|pol-reticulum)"' }
    }
    // stage('tests') — deliberately absent (his ruling 2026-09-07); ci-3 adds the isle tests here.
  }
  post {
    always {
      archiveArtifacts artifacts: '.generated/debs/*.deb', fingerprint: true, allowEmptyArchive: true
      // ci-8: mirror the outcome into Polari (posting-only credential; nothing here drives Jenkins)
      script { sh "bash /var/polari-jenkins/cicd-sync.sh run dev-build \"\$BUILD_NUMBER\" ${currentBuild.currentResult.toLowerCase()} '' 'dev build' || true" }
      sh 'bash /var/polari-jenkins/retention.sh prune || true'
      cleanWs()
    }
  }
}
