# Keycloak Admin Credentials — EXAMPLE (real file is gitignored + AUTOGENERATED)
# Generate with: ./setup-polari-security.sh dev --env-only   (random, no prompts)
# Knobs: POLARI_KC_ADMIN_USER, POLARI_KC_ADMIN_PASS.
# The admin password is baked into Keycloak's volume on FIRST boot; client
# secrets are re-PATCHed by configure_clients.sh at every startup.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME_RUN_setup-polari-security.sh
KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_ME_RUN_setup-polari-security.sh
KEYCLOAK_POLARI_BACKEND_CLIENT_SECRET=REPLACE_ME_RUN_setup-polari-security.sh
