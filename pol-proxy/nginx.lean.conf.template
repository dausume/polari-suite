# nginx.lean.conf.template — the edge of the LEAN production profile
# (docker-compose.lean.yml). Rendered by `pol prod` into
# .generated/nginx.lean.conf and shipped to the proxy as a docker config.
# Five names, one certificate (ca/cert-manifest.conf row pol-proxy-lean):
#   ${PROD_DOMAIN}, www.   the hub (site + documentation) + /downloads
#   prf.${PROD_DOMAIN}     the Polari frontend
#   api.prf.${PROD_DOMAIN} the Polari backend (HTTP + STOMP websocket)
#   apt.${PROD_DOMAIN}     the apt repository tree (static)
# :80 serves the ACME HTTP-01 webroot, then redirects.
worker_processes auto;
events { worker_connections 1024; }
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    gzip          on;
    gzip_types    text/css application/javascript image/svg+xml application/json;
    client_max_body_size 64m;

    # Docker DNS: resolve service names lazily so the proxy boots even when a
    # service is still starting (variable proxy_pass below).
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    map $http_upgrade $prf_api_target {
        default     http://prf-backend:3000;
        websocket   http://prf-backend:3001;
    }

    # ---- HTTP: ACME webroot, then redirect ---------------------------------
    server {
        listen 80;
        server_name ${PROD_DOMAIN} www.${PROD_DOMAIN} prf.${PROD_DOMAIN} api.prf.${PROD_DOMAIN} apt.${PROD_DOMAIN};
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
        }
        # a liveness probe the healthcheck can hit without a certificate
        location = /.well-known/acme-challenge/health-probe { return 200 'ok'; add_header Content-Type text/plain; }
        location / { return 301 https://$host$request_uri; }
    }

    # ---- the site + the download front door --------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${PROD_DOMAIN} www.${PROD_DOMAIN};
        ssl_certificate     /etc/nginx/certs/pol-proxy.crt;
        ssl_certificate_key /etc/nginx/certs/pol-proxy.key;

        set $hub http://pol-hub:4200;
        location / {
            proxy_pass $hub;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        # /downloads, /downloads/apps, /downloads/offline + the deb files, from the backend
        set $backend http://prf-backend:3000;
        location /downloads {
            proxy_pass $backend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 600s;
            proxy_buffering off;
        }
        # the terms documents as plain pages (terms module)
        location /terms/ {
            proxy_pass $backend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # ---- the Polari frontend -------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name prf.${PROD_DOMAIN};
        ssl_certificate     /etc/nginx/certs/pol-proxy.crt;
        ssl_certificate_key /etc/nginx/certs/pol-proxy.key;
        set $frontend http://prf-frontend:4200;
        location / {
            proxy_pass $frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # ---- the Polari backend (HTTP + STOMP over websocket) ---------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name api.prf.${PROD_DOMAIN};
        ssl_certificate     /etc/nginx/certs/pol-proxy.crt;
        ssl_certificate_key /etc/nginx/certs/pol-proxy.key;
        location = /health { add_header Content-Type application/json; return 200 '{"status":"ok","service":"prf-backend-proxy"}'; }
        location / {
            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' 'https://prf.${PROD_DOMAIN}' always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, Accept, Origin, X-Requested-With' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Max-Age' 86400;
                add_header 'Content-Type' 'text/plain charset=UTF-8';
                add_header 'Content-Length' 0;
                return 204;
            }
            proxy_pass $prf_api_target;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 600s;
            proxy_buffering off;
        }
    }

    # ---- the apt repository --------------------------------------------------
    # deb [signed-by=/usr/share/keyrings/polari.gpg] https://apt.${PROD_DOMAIN} stable main
    server {
        listen 443 ssl;
        http2 on;
        server_name apt.${PROD_DOMAIN};
        ssl_certificate     /etc/nginx/certs/pol-proxy.crt;
        ssl_certificate_key /etc/nginx/certs/pol-proxy.key;
        root /srv/apt;
        autoindex on;
        autoindex_exact_size off;
        location = /health { add_header Content-Type application/json; return 200 '{"status":"ok","service":"apt"}'; }
        location / { try_files $uri $uri/ =404; }
    }
}
